{%- comment -%}
  RBX MOROCCO — High-converting COD landing page section.
  Drop into any Shopify theme. All copy/images editable via theme customizer (schema below).
  Images use snippets/rbx-placeholder.liquid so the page builds before real assets land.
{%- endcomment -%}

{{ 'rbx-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign price = s.price | default: '299 DH'
  assign compare = s.compare_price | default: '399 DH'
  assign rating = s.rating | default: '4.8'
  assign reviews_count = s.reviews_count | default: '1,200+'
  assign orders_count = s.orders_count | default: '8,500+'
  assign wa_raw = s.whatsapp | default: '212600000000'
  assign wa_num = wa_raw | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = s.whatsapp_msg | default: 'Salam, bghit ncommandi RBX Kit (COD)'
-%}
{%- comment -%} build a clean wa.me link (encode only the message) {%- endcomment -%}
{%- capture wa_link -%}https://wa.me/{{ wa_num }}?text={{ wa_msg | url_encode }}{%- endcapture -%}

{%- comment -%} --- Inline SVG icon set (capture once, reuse) --- {%- endcomment -%}
{%- capture ic_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{%- endcapture -%}
{%- capture ic_x -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>{%- endcapture -%}
{%- capture ic_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>{%- endcapture -%}
{%- capture ic_cash -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></svg>{%- endcapture -%}
{%- capture ic_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>{%- endcapture -%}
{%- capture ic_swap -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>{%- endcapture -%}
{%- capture ic_bolt -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>{%- endcapture -%}
{%- capture ic_drop -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>{%- endcapture -%}
{%- capture ic_muscle -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-2 4 4 2-6"/><path d="M3 12v4a4 4 0 0 0 4 4h7a6 6 0 0 0 6-6V7"/></svg>{%- endcapture -%}
{%- capture ic_gem -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 18 3 22 9 12 22 2 9 6 3"/><line x1="2" y1="9" x2="22" y2="9"/></svg>{%- endcapture -%}
{%- capture ic_gift -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>{%- endcapture -%}
{%- capture ic_star -%}<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endcapture -%}
{%- capture ic_wa -%}<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.84 9.84 0 0 0 12.04 2zm0 18.13c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>{%- endcapture -%}
{%- capture ic_ruler -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 8.7 8.7 21.3a1 1 0 0 1-1.4 0l-4.6-4.6a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4z"/><path d="M7.5 10.5l2 2M10.5 7.5l2 2M13.5 4.5l2 2"/></svg>{%- endcapture -%}
{%- capture ic_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>{%- endcapture -%}
{%- comment -%} 5-star block (reused) {%- endcomment -%}
{%- capture stars5 -%}<span class="rbx-stars">{{ ic_star }}{{ ic_star }}{{ ic_star }}{{ ic_star }}{{ ic_star }}</span>{%- endcapture -%}

<div class="rbx rbx-pb-sticky" id="rbx-top">

  {%- comment -%} ============ 0. ANNOUNCEMENT BAR ============ {%- endcomment -%}
  <div class="rbx-announce">
    <div class="rbx-announce__track">
      <span>{{ ic_cash }} {{ s.announce_1 | default: 'Paiement à la livraison' }}</span>
      <span>{{ ic_truck }} {{ s.announce_2 | default: 'Livraison GRATUITE partout au Maroc' }}</span>
      <span>{{ ic_bolt }} {{ s.announce_3 | default: 'Offre limitée — stock 9lil' }}</span>
    </div>
  </div>

  {%- comment -%} ============ 1. HERO ============ {%- endcomment -%}
  <section class="rbx-hero">
    <div class="rbx-hero__media">
      {%- render 'rbx-placeholder', image: s.hero_image, asset: 'hero-bodybuilder-1.webp', label: 'hero-bodybuilder-1', ratio: '3-4', eager: true, alt: 'RBX athlete' -%}
    </div>
    <div class="rbx-hero__inner">
      <p class="rbx__eyebrow">{{ s.hero_eyebrow | default: 'RBX MOROCCO · PREMIUM SPORTSWEAR' }}</p>
      <h1 class="rbx__h1">{{ s.hero_title | default: 'BAN SPORTIF. BAN M3ADAD.' }}</h1>

      <div class="rbx-rating rbx-hero__rating">
        {{ stars5 }}
        <span class="rbx-rating__txt"><b>{{ rating }}/5</b> · {{ reviews_count }} {{ s.reviews_word | default: 'avis vérifiés' }}</span>
      </div>

      <p class="rbx__lead">{{ s.hero_sub | default: "L'ensemble 2-en-1 compression li ghadi ybayan corps dyalk f gym. Premium, athletic, confiance f kola séance." }}</p>

      <div class="rbx-hero__price">
        <b>{{ price }}</b>
        {%- if compare != blank -%}<s>{{ compare }}</s>{%- endif -%}
        {%- if s.discount_badge != blank -%}<span class="rbx-badge-off">{{ s.discount_badge }}</span>{%- else -%}<span class="rbx-badge-off">-25%</span>{%- endif -%}
      </div>

      <div class="rbx-cta-block">
        <a href="#rbx-order" class="rbx-btn" data-rbx-scroll>{{ s.cta_primary | default: 'COMMANDER MAINTENANT' }}</a>
        {%- if wa_num != blank and wa_num != '212600000000' -%}
          <a href="{{ wa_link }}" class="rbx-btn rbx-btn--wa" target="_blank" rel="nofollow noopener">{{ ic_wa }} {{ s.wa_btn | default: 'Commander via WhatsApp' }}</a>
        {%- endif -%}
        <p class="rbx__p rbx-mb-0 rbx-mt-8" style="font-size:13px">{{ ic_cash }} {{ s.cta_micro | default: 'Khalas mnin toselek · ماشي خلاص قبل · Échange gratuit' }}</p>
      </div>

      <div class="rbx-strip">
        <span class="rbx-strip__item">{{ ic_cash }} Paiement à la livraison</span>
        <span class="rbx-strip__item">{{ ic_truck }} Livraison gratuite</span>
        <span class="rbx-strip__item">{{ ic_shield }} Garantie 30 jours</span>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 2. WHY ATHLETES CHOOSE RBX ============ {%- endcomment -%}
  <section class="rbx__section rbx__section--alt">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow rbx__center">3awtani</p>
      <h2 class="rbx__h2 rbx__center">{{ s.why_title | default: 'علاش les athlètes كيختارو RBX' }}</h2>
      <div class="rbx-grid rbx-grid--2 rbx-grid--cards4 rbx-mt-24">
        {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
        {%- if benefit_blocks.size > 0 -%}
          {%- for b in benefit_blocks -%}
            <div class="rbx-card" {{ b.shopify_attributes }}>
              <div class="rbx-card__icon">
                {%- case b.settings.icon -%}
                  {%- when 'gem' -%}{{ ic_gem }}
                  {%- when 'drop' -%}{{ ic_drop }}
                  {%- when 'shield' -%}{{ ic_shield }}
                  {%- when 'muscle' -%}{{ ic_muscle }}
                  {%- when 'bolt' -%}{{ ic_bolt }}
                  {%- else -%}{{ ic_check }}
                {%- endcase -%}
              </div>
              <h3 class="rbx__h3">{{ b.settings.title }}</h3>
              <p class="rbx__p rbx-mb-0">{{ b.settings.text }}</p>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="rbx-card"><div class="rbx-card__icon">{{ ic_gem }}</div><h3 class="rbx__h3">Qualité Premium</h3><p class="rbx__p rbx-mb-0">Tissu compression importé, finition premium. Machi cheap marketplace.</p></div>
          <div class="rbx-card"><div class="rbx-card__icon">{{ ic_muscle }}</div><h3 class="rbx__h3">Fit Parfait</h3><p class="rbx__p rbx-mb-0">Coupe athletic li katbayan l'muscles. Kayban 3lik m3adad.</p></div>
          <div class="rbx-card"><div class="rbx-card__icon">{{ ic_shield }}</div><h3 class="rbx__h3">Durable</h3><p class="rbx__p rbx-mb-0">Kayb9a lawn w forme mn b3d ghasil. Ma kaytl9ach.</p></div>
          <div class="rbx-card"><div class="rbx-card__icon">{{ ic_drop }}</div><h3 class="rbx__h3">Anti-Transpiration</h3><p class="rbx__p rbx-mb-0">Tissu respirant kaymtass l3rg. Confort f kola séance.</p></div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ 3. TRANSFORMATION BENEFITS ============ {%- endcomment -%}
  <section class="rbx__section">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow">La transformation</p>
      <h2 class="rbx__h2">{{ s.transform_title | default: "MACHI غير tenue. هادشي confiance." }}</h2>
      <p class="rbx__p">{{ s.transform_text | default: "Melli katlbess RBX, katban أقوى, plus athletic, w plus professional. Corps dyalk kaybayan ahsan, w nta kathss b confiance kbira f gym wla f terrain." }}</p>
      <div class="rbx-grid rbx-grid--2 rbx-grid--stack-sm rbx-mt-16">
        {%- render 'rbx-placeholder', image: s.transform_image_1, asset: 'gym-scene-1.webp', label: 'gym-scene-1', ratio: '4-5' -%}
        {%- render 'rbx-placeholder', image: s.transform_image_2, asset: 'football-scene.webp', label: 'football-scene', ratio: '4-5' -%}
      </div>
      <ul class="rbx-list rbx-list--good rbx-mt-24">
        <li>{{ ic_check }} Kaban 3lik plus musclé</li>
        <li>{{ ic_check }} Look athletic w professional</li>
        <li>{{ ic_check }} Confiance f kola entrainement</li>
        <li>{{ ic_check }} Style fitness influencer</li>
      </ul>
    </div>
  </section>

  {%- comment -%} CTA #1 {%- endcomment -%}
  <section class="rbx__section--tight"><div class="rbx__wrap rbx-cta-block">
    <a href="#rbx-order" class="rbx-btn" data-rbx-scroll>{{ s.cta_secondary | default: 'بغيت نشري دابا — 299 DH' }}</a>
  </div></section>

  {%- comment -%} ============ 4. PREMIUM FABRIC SHOWCASE ============ {%- endcomment -%}
  <section class="rbx__section rbx__section--alt">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow">Le tissu</p>
      <h2 class="rbx__h2">{{ s.fabric_title | default: 'TISSU COMPRESSION PREMIUM' }}</h2>
      <div class="rbx-grid rbx-grid--2 rbx-grid--stack-sm">
        {%- render 'rbx-placeholder', image: s.fabric_image_1, asset: 'fabric-closeup-1.webp', label: 'fabric-closeup-1', ratio: '1-1' -%}
        {%- render 'rbx-placeholder', image: s.fabric_image_2, asset: 'fabric-closeup-2.webp', label: 'fabric-closeup-2', ratio: '1-1' -%}
      </div>
      <ul class="rbx-list rbx-list--good rbx-mt-24">
        <li>{{ ic_check }} Compression li katsupport l'muscles</li>
        <li>{{ ic_check }} Respirant — ma kay3reqch</li>
        <li>{{ ic_check }} Kayhfad forme — ma kaytmddch</li>
        <li>{{ ic_check }} Matériaux importés premium</li>
      </ul>
    </div>
  </section>

  {%- comment -%} ============ 5. BEFORE / AFTER FEELING ============ {%- endcomment -%}
  <section class="rbx__section">
    <div class="rbx__wrap">
      <h2 class="rbx__h2 rbx__center">{{ s.ba_title | default: 'الفرق كاين' }}</h2>
      <div class="rbx-ba rbx-mt-24">
        <div class="rbx-ba__col rbx-ba__col--bad">
          <p class="rbx-ba__tag">9bel · sportswear cheap</p>
          <ul class="rbx-list rbx-list--bad">
            <li>{{ ic_x }} Kaytl9 forme mn b3d ghasil</li>
            <li>{{ ic_x }} Taille ghalta</li>
            <li>{{ ic_x }} Tissu khayb kay3req</li>
            <li>{{ ic_x }} Walou confiance</li>
          </ul>
        </div>
        <div class="rbx-ba__col rbx-ba__col--good">
          <p class="rbx-ba__tag">m3a RBX</p>
          <ul class="rbx-list rbx-list--good">
            <li>{{ ic_check }} Kayb9a parfait dima</li>
            <li>{{ ic_check }} Fit athletic mzyan</li>
            <li>{{ ic_check }} Respirant w confortable</li>
            <li>{{ ic_check }} Confiance 100%</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 5b. SOCIAL PROOF / REVIEWS ============ {%- endcomment -%}
  <section class="rbx__section rbx__section--alt">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow rbx__center">{{ s.reviews_eyebrow | default: 'Ils nous font confiance' }}</p>
      <h2 class="rbx__h2 rbx__center">{{ s.reviews_title | default: 'شنو كيقولو الرياضيين' }}</h2>

      <div class="rbx-proofbar">
        <div class="rbx-proofbar__cell">
          <span class="rbx-proofbar__num">{{ orders_count }}</span>
          <span class="rbx-proofbar__lbl">{{ s.orders_word | default: 'commandes livrées' }}</span>
        </div>
        <div class="rbx-proofbar__cell">
          <div class="rbx-rating">{{ stars5 }}</div>
          <span class="rbx-proofbar__lbl">{{ rating }}/5 · {{ reviews_count }} {{ s.reviews_word | default: 'avis vérifiés' }}</span>
        </div>
        <div class="rbx-proofbar__cell">
          <span class="rbx-proofbar__num">98%</span>
          <span class="rbx-proofbar__lbl">{{ s.recommend_word | default: 'le recommandent' }}</span>
        </div>
      </div>

      <div class="rbx-reviews rbx-mt-24">
        {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
        {%- if review_blocks.size > 0 -%}
          {%- for r in review_blocks -%}
            <div class="rbx-review" {{ r.shopify_attributes }}>
              <div class="rbx-review__top">
                <div class="rbx-review__av">{%- render 'rbx-placeholder', image: r.settings.photo, label: 'review', ratio: '1-1' -%}</div>
                <div class="rbx-review__who">
                  <b>{{ r.settings.name }}</b>
                  <span>{{ r.settings.city }}</span>
                  <span class="rbx-review__verified">{{ ic_check }} {{ s.verified_word | default: 'Achat vérifié' }}</span>
                </div>
              </div>
              {{ stars5 }}
              <p class="rbx-review__txt">{{ r.settings.text }}</p>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="rbx-review"><div class="rbx-review__top"><div class="rbx-review__av">{%- render 'rbx-placeholder', image: blank, asset: 'review-1.webp', label: 'review-1', ratio: '1-1' -%}</div><div class="rbx-review__who"><b>Yassine B.</b><span>Casablanca</span><span class="rbx-review__verified">{{ ic_check }} Achat vérifié</span></div></div>{{ stars5 }}<p class="rbx-review__txt">Tissu top, kayban m3adad b9el. Manchettes free hadya zwina. Wsalni f 3 ayam, khlast f dar.</p></div>
          <div class="rbx-review"><div class="rbx-review__top"><div class="rbx-review__av">{%- render 'rbx-placeholder', image: blank, asset: 'review-2.webp', label: 'review-2', ratio: '1-1' -%}</div><div class="rbx-review__who"><b>Mehdi R.</b><span>Rabat</span><span class="rbx-review__verified">{{ ic_check }} Achat vérifié</span></div></div>{{ stars5 }}<p class="rbx-review__txt">9addit dial taille mzyana. Tissu ma kay3reqch w kayb9a forme mn b3d ghasil. Nconseille.</p></div>
          <div class="rbx-review"><div class="rbx-review__top"><div class="rbx-review__av">{%- render 'rbx-placeholder', image: blank, label: 'review-3', ratio: '1-1' -%}</div><div class="rbx-review__who"><b>Anas T.</b><span>Marrakech</span><span class="rbx-review__verified">{{ ic_check }} Achat vérifié</span></div></div>{{ stars5 }}<p class="rbx-review__txt">Qualité premium 100%. Khlast mnin wsalni, b9it mrtah. Look pro f gym, confiance kbira.</p></div>
        {%- endif -%}
      </div>

      <div class="rbx-cta-block rbx-mt-24">
        <a href="#rbx-order" class="rbx-btn" data-rbx-scroll>{{ s.cta_primary | default: 'COMMANDER MAINTENANT' }}</a>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 6. WHAT'S INCLUDED ============ {%- endcomment -%}
  <section class="rbx__section rbx__section--alt">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow">Le pack</p>
      <h2 class="rbx__h2">{{ s.incl_title | default: 'شنو غادي توصلك' }}</h2>
      <div class="rbx-incl rbx-mt-16">
        <div class="rbx-incl__row">
          {%- render 'rbx-placeholder', image: s.incl_image_1, asset: 'front-view.webp', label: 'product-front', ratio: '1-1' -%}
          <div><h3 class="rbx__h3">T-shirt RBX Pro</h3><p class="rbx__p rbx-mb-0">Maillot compression premium, coupe athletic.</p></div>
        </div>
        <div class="rbx-incl__row">
          {%- render 'rbx-placeholder', image: s.incl_image_2, asset: 'back-view.webp', label: 'product-back', ratio: '1-1' -%}
          <div><h3 class="rbx__h3">Short RBX Pro</h3><p class="rbx__p rbx-mb-0">Short assorti, tissu respirant, liberté totale.</p></div>
        </div>
        <div class="rbx-incl__row">
          {%- render 'rbx-placeholder', image: s.incl_image_3, asset: 'free-sleeves.webp', label: 'free-sleeves', ratio: '1-1' -%}
          <div><span class="rbx-incl__free">+ GRATUIT</span><h3 class="rbx__h3">2 Manchettes Compression</h3><p class="rbx__p rbx-mb-0">Cadeau m3a kola commande. Support l'bras f training.</p></div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 7. FREE GIFT ============ {%- endcomment -%}
  <section class="rbx__section">
    <div class="rbx__wrap">
      <div class="rbx-gift">
        <div class="rbx-card__icon" style="margin:0 auto 14px">{{ ic_gift }}</div>
        <span class="rbx-gift__badge">Cadeau offert</span>
        <h2 class="rbx__h2">{{ s.gift_title | default: '2 MANCHETTES DE COMPRESSION — GRATUITES' }}</h2>
        <p class="rbx__p">{{ s.gift_text | default: "M3a kola RBX kit, kateddi 2 manchettes compression b 0 DH. Support l'muscles dyal draa3, look complet d'athlète pro." }}</p>
        <div class="rbx-cta-block rbx-mt-8">
          <a href="#rbx-order" class="rbx-btn" data-rbx-scroll>{{ s.cta_primary | default: 'COMMANDER MAINTENANT' }}</a>
        </div>
      </div>
    </div>
