  </section>

  {%- comment -%} ============ 10. ORDER FORM (COD) ============ {%- endcomment -%}
  <section class="rbx__section rbx__section--alt" id="rbx-order">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow rbx__center">{{ ic_cash }} Paiement à la livraison</p>
      <h2 class="rbx__h2 rbx__center">{{ s.order_title | default: 'كمل الطلب ديالك' }}</h2>
      <p class="rbx__p rbx__center">3mmer les informations w ghadi nt9onta3o m3ak l'tأكيد. Katkhalas <b class="rbx__hl">mnin toselek</b>.</p>

      {%- if s.urgency_enable == false -%}{%- else -%}
      <div class="rbx-urgency">
        <span class="rbx-urgency__stock"><span class="rbx-urgency__dot"></span>{{ s.stock_left | default: '37' }} {{ s.stock_word | default: 'kits restants — stock 9lil' }}</span>
        <span class="rbx-urgency__timer">{{ ic_clock }} {{ s.timer_word | default: "L'offre se termine dans" }}
          <span class="rbx-urgency__clock" data-rbx-countdown data-minutes="{{ s.timer_minutes | default: 120 }}" data-key="offer">
            <b data-cd-h>00</b><b data-cd-m>00</b><b data-cd-s>00</b>
          </span>
        </span>
      </div>
      {%- endif -%}

      <div class="rbx-order rbx-mt-16" data-rbx-order>
        <form class="rbx-order__form" action="{{ s.form_action | default: '#' }}" method="post" novalidate data-rbx-form>
          <div class="rbx-field" data-field>
            <label for="rbx-name">Nom complet *</label>
            <input type="text" id="rbx-name" name="name" autocomplete="name" placeholder="Smitek lkamel" required>
            <span class="rbx-field__err">3afak 3mmer smitek.</span>
          </div>
          <div class="rbx-field" data-field>
            <label for="rbx-phone">Téléphone *</label>
            <input type="tel" id="rbx-phone" name="phone" autocomplete="tel" inputmode="numeric" placeholder="06 12 34 56 78" required>
            <span class="rbx-field__err">3afak 3mmer numéro s7i7 (10 chiffres).</span>
          </div>
          <div class="rbx-field" data-field>
            <label for="rbx-city">Ville *</label>
            <input type="text" id="rbx-city" name="city" autocomplete="address-level2" placeholder="Casablanca, Rabat..." required>
            <span class="rbx-field__err">3afak 3mmer lmadina.</span>
          </div>
          <div class="rbx-field" data-field>
            <label for="rbx-address">Adresse *</label>
            <textarea id="rbx-address" name="address" rows="2" autocomplete="street-address" placeholder="3onwan kamel l'livraison" required></textarea>
            <span class="rbx-field__err">3afak 3mmer l3onwan.</span>
          </div>

          <div class="rbx-field" data-field data-pillgroup="size">
            <label>Taille *</label>
            <div class="rbx-pills" role="radiogroup" aria-label="Taille">
              {%- assign sizes = 'M,L,XL,XXL' | split: ',' -%}
              {%- for sz in sizes -%}
                <label class="rbx-pill"><input type="radio" name="size" value="{{ sz }}" required>{{ sz }}</label>
              {%- endfor -%}
            </div>
            <span class="rbx-field__err">3afak khtar taille.</span>

            <div class="rbx-sizeguide" data-rbx-sizeguide>
              <button type="button" class="rbx-sizeguide__toggle">{{ ic_ruler }} {{ s.sizeguide_word | default: 'Guide des tailles' }}</button>
              <div class="rbx-sizeguide__panel">
                <table class="rbx-sizetable">
                  <thead><tr><th>Taille</th><th>Poids</th><th>Taille (cm)</th></tr></thead>
                  <tbody>
                    <tr><td>M</td><td>55–65 kg</td><td>165–172</td></tr>
                    <tr><td>L</td><td>65–78 kg</td><td>172–180</td></tr>
                    <tr><td>XL</td><td>78–90 kg</td><td>180–188</td></tr>
                    <tr><td>XXL</td><td>90–105 kg</td><td>188–196</td></tr>
                  </tbody>
                </table>
                <p class="rbx__p rbx-mb-0 rbx-mt-8" style="font-size:12px">{{ ic_swap }} {{ s.sizeguide_note | default: 'Pas sûr? Échange taille GRATUIT après livraison.' }}</p>
              </div>
            </div>
          </div>

          <div class="rbx-field" data-pillgroup="qty">
            <label>Quantité</label>
            <div class="rbx-pills" role="radiogroup" aria-label="Quantité">
              <label class="rbx-pill rbx-pill--active"><input type="radio" name="qty" value="1" checked>1<small>kit</small></label>
              <label class="rbx-pill"><input type="radio" name="qty" value="2">2<small>−{{ s.save2 | default: '99' }} DH</small></label>
              <label class="rbx-pill"><input type="radio" name="qty" value="3">3<small>−{{ s.save3 | default: '198' }} DH</small></label>
            </div>
          </div>

          <div class="rbx-sum"
               data-rbx-sum
               data-unit="{{ s.price_value | default: 299 }}"
               data-currency="{{ s.currency | default: 'DH' }}"
               data-bundle="{{ s.bundle_prices | default: '1:299,2:499,3:699' }}">
            <div class="rbx-sum__row"><span data-sum-label>RBX Kit × 1</span><span data-sum-sub>299 DH</span></div>
            <div class="rbx-sum__row" data-sum-saverow style="display:none"><span>Remise pack</span><span class="rbx-sum__free" data-sum-save>− 0 DH</span></div>
            <div class="rbx-sum__row"><span>Manchettes (×2)</span><span class="rbx-sum__free">GRATUIT</span></div>
            <div class="rbx-sum__row"><span>Livraison</span><span class="rbx-sum__free">GRATUITE</span></div>
            <div class="rbx-sum__row rbx-sum__row--total"><span>Total à payer</span><b data-sum-total>299 DH</b></div>
          </div>

          <button type="submit" class="rbx-btn">{{ s.order_btn | default: 'تأكيد الطلب — COD' }}</button>

          {%- if wa_num != blank and wa_num != '212600000000' -%}
            <p class="rbx-or">— wla —</p>
            <a href="{{ wa_link }}" class="rbx-btn rbx-btn--wa" target="_blank" rel="nofollow noopener">{{ ic_wa }} {{ s.wa_btn | default: 'Commander via WhatsApp' }}</a>
          {%- endif -%}

          <div class="rbx-order__reassure">
            <span>{{ ic_cash }} Paiement à la livraison — ماشي خلاص قبل</span>
            <span>{{ ic_truck }} Livraison gratuite partout au Maroc</span>
            <span>{{ ic_swap }} Échange taille gratuit · {{ ic_shield }} Garantie 30 jours</span>
          </div>
        </form>

        <div class="rbx-order__success">
          {{ ic_shield }}
          <h3 class="rbx__h3">شكراً! Commande mأكدة</h3>
          <p class="rbx__p rbx-mb-0">Ghadi nt9onta3o m3ak f a9rab w9t bach n'akkdo commande. (Démo — wsl form b endpoint d'COD).</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 11. STICKY CTA ============ {%- endcomment -%}
  <div class="rbx-sticky" data-rbx-sticky aria-hidden="true">
    <div class="rbx-sticky__price">
      <b>{{ price }}</b>
      <small>COD · Livraison gratuite</small>
    </div>
    {%- if wa_num != blank and wa_num != '212600000000' -%}
      <a href="{{ wa_link }}" class="rbx-sticky__wa" target="_blank" rel="nofollow noopener" aria-label="WhatsApp">{{ ic_wa }}</a>
    {%- endif -%}
    <a href="#rbx-order" class="rbx-btn" data-rbx-scroll>{{ s.sticky_btn | default: 'COMMANDER' }}</a>
  </div>

</div>

