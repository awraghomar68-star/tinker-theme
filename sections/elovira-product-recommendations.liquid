{%- comment -%}
  ELOVIRA — Product Recommendations (Phase 7 PDP).
  Reuses Shopify's native Section Rendering API recommendation
  mechanism (product-recommendations.js + morphSection) — same
  fetch/hydrate contract as Horizon's product-recommendations
  section. No custom recommendation engine, no bespoke AJAX.
  Only the card markup differs: renders elovira-product-card
  instead of the native _product-card theme block, so results match
  the rest of the storefront (PLP/Home/Search already use this atom).
{%- endcomment -%}

{{ 'elovira-product-recommendations.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign heading = section.settings.heading
  assign max_products = section.settings.max_products | default: 4
%}

<product-recommendations
  id="product-recommendations-{{ section.id }}"
  class="elovira elovira-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ section.settings.product.id | default: product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-testid="elovira-product-recommendations"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="section elovira-recommendations__section"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if heading != blank %}
      <h2 class="elovira-recommendations__heading">{{ heading }}</h2>
    {% endif %}

    {%- if recommendations.performed or section.settings.product == blank -%}
      {% liquid
        if section.settings.product == blank
          # Onboarding mode: show placeholder products
          assign products = null
        elsif recommendations.performed and recommendations.products_count == 0
          if section.settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', section.settings.product.id
          else
            assign products = null
          endif
        else
          assign products = recommendations.products
        endif
      %}

      {% if products != blank %}
        <div class="elovira-recommendations__grid" data-testid="elovira-recommendations-grid">
          {% for product in products limit: max_products %}
            {% render 'elovira-product-card', product: product %}
          {% endfor %}
        </div>
      {% endif %}
    {%- else -%}
      <div class="elovira-recommendations__grid" data-testid="elovira-recommendations-skeleton">
        {% for i in (1..max_products) %}
          <div
            class="elovira-recommendations__skeleton"
            aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
          ></div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

{% schema %}
{
  "name": "ELOVIRA Recommendations",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "ELOVIRA Recommendations",
      "category": "t:categories.products",
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "heading": "You may also like",
        "max_products": 4
      }
    }
  ]
}
{% endschema %}
