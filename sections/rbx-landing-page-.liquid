  {%- comment -%} ============ 10. ORDER FORM (COD) ============ {%- endcomment -%}
  <section class="rbx__section rbx__section--alt" id="rbx-order">
    <div class="rbx__wrap">
      <p class="rbx__eyebrow rbx__center">{{ ic_cash }} Paiement à la livraison</p>
      <h2 class="rbx__h2 rbx__center">{{ s.order_title | default: 'كمل الطلب ديالك' }}</h2>
      <p class="rbx__p rbx__center">{{ prod_title }} — 3mmer les informations w ghadi nt9onta3o m3ak l'تأكيد. Katkhalas <b class="rbx__hl">mnin toselek</b>.</p>

      {%- if s.urgency_enable == false -%}{%- else -%}
      <div class="rbx-urgency">
        <span class="rbx-urgency__stock"><span class="rbx-urgency__dot"></span>{{ s.stock_left | default: '37' }} {{ s.stock_word | default: 'kits restants — stock 9lil' }}</span>
        <span class="rbx-urgency__timer">{{ ic_clock }} {{ s.timer_word | default: "L'offre se termine dans" }}
          <span class="rbx-urgency__clock" data-rbx-countdown data-minutes="{{ s.timer_minutes | default: 120 }}" data-key="offer" data-deadline="{{ s.timer_end }}" aria-hidden="true">
            <b data-cd-h>00</b><b data-cd-m>00</b><b data-cd-s>00</b>
          </span>
        </span>
      </div>
      {%- endif -%}

      <div class="rbx-order rbx-mt-16" data-rbx-order>
        <form class="rbx-order__form" action="{{ s.form_action | default: '#' }}" method="post" novalidate data-rbx-form>
          {%- if p != blank -%}<input type="hidden" name="product_id" value="{{ p.id }}">{%- endif -%}
          <input type="hidden" name="variant_id" value="" data-rbx-variant>
          <input type="hidden" name="product_title" value="{{ prod_title | escape }}">
          <input type="hidden" name="currency" value="{{ s.currency | default: 'DH' }}">
          <input type="hidden" name="total" value="{{ unit_value }}" data-rbx-total>

          <div class="rbx-field" data-field>
            <label for="rbx-name">Nom complet *</label>
            <input type="text" id="rbx-name" name="name" autocomplete="name" placeholder="Smitek lkamel" required>
            <span class="rbx-field__err">3afak 3mmer smitek.</span>
          </div>
          <div class="rbx-field" data-field>
            <label for="rbx-phone">Téléphone *</label>
            <input type="tel" id="rbx-phone" name="phone" autocomplete="tel" inputmode="numeric" placeholder="06 12 34 56 78" required>
            <span class="rbx-field__err">3afak 3mmer numéro s7i7 (10 chiffres).</span>
          </div>
          <div class="rbx-field" data-field>
            <label for="rbx-city">Ville *</label>
            <input type="text" id="rbx-city" name="city" autocomplete="address-level2" placeholder="Casablanca, Rabat..." required>
            <span class="rbx-field__err">3afak 3mmer lmadina.</span>
          </div>
          <div class="rbx-field" data-field>
            <label for="rbx-address">Adresse *</label>
            <textarea id="rbx-address" name="address" rows="2" autocomplete="street-address" placeholder="3onwan kamel l'livraison" required></textarea>
            <span class="rbx-field__err">3afak 3mmer l3onwan.</span>
          </div>

          <div class="rbx-field" data-field data-pillgroup="size">
            <label>Taille *</label>
            <div class="rbx-pills" role="radiogroup" aria-label="Taille">
              {%- if size_opt != blank -%}
                {%- assign size_idx = size_opt.position | minus: 1 -%}
                {%- for val in size_opt.values -%}
                  {%- assign vid = '' -%}
                  {%- assign avail = false -%}
                  {%- for v in p.variants -%}
                    {%- assign vopt = v.options[size_idx] -%}
                    {%- if vopt == val -%}
                      {%- assign vid = v.id -%}
                      {%- if v.available -%}{%- assign avail = true -%}{%- endif -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <label class="rbx-pill{% unless avail %} rbx-pill--soldout{% endunless %}">
                    <input type="radio" name="size" value="{{ val | escape }}" data-variant-id="{{ vid }}"{% unless avail %} disabled{% endunless %} required>{{ val }}
                  </label>
                {%- endfor -%}
              {%- else -%}
                {%- assign sizes = 'M,L,XL,XXL' | split: ',' -%}
                {%- for sz in sizes -%}
                  <label class="rbx-pill"><input type="radio" name="size" value="{{ sz }}" required>{{ sz }}</label>
                {%- endfor -%}
              {%- endif -%}
            </div>
            <span class="rbx-field__err">3afak khtar taille.</span>

            <div class="rbx-sizeguide" data-rbx-sizeguide>
              <button type="button" class="rbx-sizeguide__toggle">{{ ic_ruler }} {{ s.sizeguide_word | default: 'Guide des tailles' }}</button>
              <div class="rbx-sizeguide__panel">
                <table class="rbx-sizetable">
                  <thead><tr><th>Taille</th><th>Poids</th><th>Taille (cm)</th></tr></thead>
                  <tbody>
                    <tr><td>M</td><td>55–65 kg</td><td>165–172</td></tr>
                    <tr><td>L</td><td>65–78 kg</td><td>172–180</td></tr>
                    <tr><td>XL</td><td>78–90 kg</td><td>180–188</td></tr>
                    <tr><td>XXL</td><td>90–105 kg</td><td>188–196</td></tr>
                  </tbody>
                </table>
                <p class="rbx__p rbx-mb-0 rbx-mt-8" style="font-size:12px">{{ ic_swap }} {{ s.sizeguide_note | default: 'Pas sûr? Échange taille GRATUIT après livraison.' }}</p>
              </div>
            </div>
          </div>

          <div class="rbx-field" data-pillgroup="qty">
            <label>Quantité</label>
            <div class="rbx-pills" role="radiogroup" aria-label="Quantité">
              <label class="rbx-pill rbx-pill--active"><input type="radio" name="qty" value="1" checked>1<small>kit</small></label>
              <label class="rbx-pill"><input type="radio" name="qty" value="2">2<small>−{{ s.save2 | default: '99' }} {{ s.currency | default: 'DH' }}</small></label>
              <label class="rbx-pill"><input type="radio" name="qty" value="3">3<small>−{{ s.save3 | default: '198' }} {{ s.currency | default: 'DH' }}</small></label>
            </div>
          </div>

          <div class="rbx-sum"
               data-rbx-sum
               data-unit="{{ unit_value }}"
               data-currency="{{ s.currency | default: 'DH' }}"
               data-bundle="{{ s.bundle_prices }}"
               data-save2="{{ s.save2 | default: '99' }}"
               data-save3="{{ s.save3 | default: '198' }}">
            <div class="rbx-sum__row"><span data-sum-label>RBX Kit × 1</span><span data-sum-sub>{{ unit_value }} {{ s.currency | default: 'DH' }}</span></div>
            <div class="rbx-sum__row" data-sum-saverow style="display:none"><span>Remise pack</span><span class="rbx-sum__free" data-sum-save>− 0 DH</span></div>
            <div class="rbx-sum__row"><span>Manchettes (×2)</span><span class="rbx-sum__free">GRATUIT</span></div>
            <div class="rbx-sum__row"><span>Livraison</span><span class="rbx-sum__free">GRATUITE</span></div>
            <div class="rbx-sum__row rbx-sum__row--total"><span>Total à payer</span><b data-sum-total>{{ unit_value }} {{ s.currency | default: 'DH' }}</b></div>
          </div>

          <button type="submit" class="rbx-btn">{{ s.order_btn | default: 'تأكيد الطلب — COD' }}</button>

          {%- if wa_num != blank and wa_num != '212600000000' -%}
            <p class="rbx-or">— wla —</p>
            <a href="{{ wa_link }}" class="rbx-btn rbx-btn--wa" target="_blank" rel="nofollow noopener">{{ ic_wa }} {{ s.wa_btn | default: 'Commander via WhatsApp' }}</a>
          {%- endif -%}

          <div class="rbx-order__reassure">
            <span>{{ ic_cash }} Paiement à la livraison — ماشي خلاص قبل</span>
            <span>{{ ic_truck }} Livraison gratuite partout au Maroc</span>
            <span>{{ ic_swap }} Échange taille gratuit · {{ ic_shield }} Garantie 30 jours</span>
          </div>
        </form>

        <div class="rbx-order__success" role="status" tabindex="-1">
          {{ ic_shield }}
          <h3 class="rbx__h3">شكراً! Commande مأكدة</h3>
          <p class="rbx__p rbx-mb-0">Ghadi nt9onta3o m3ak f a9rab w9t bach n'akkdo commande. (Démo — wsl form b endpoint d'COD).</p>
        </div>

        <div class="rbx-order__error" role="alert" hidden>
          {{ ic_x }}
          <h3 class="rbx__h3">{{ s.order_error_title | default: 'Erreur — 3awd 7awl' }}</h3>
          <p class="rbx__p rbx-mb-0">{{ s.order_error_text | default: "Ma t'sift'ch commande. 3afak 3awd 7awl, wla commandi via WhatsApp." }}</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ 10b. FOOTER / LEGITIMACY ============ {%- endcomment -%}
  {%- assign has_links = false -%}
  {%- if s.returns_url != blank or s.contact_url != blank or s.legal_url != blank -%}{%- assign has_links = true -%}{%- endif -%}
  {%- if s.legal_company != blank or s.legal_phone != blank or s.legal_email != blank or s.legal_address != blank or has_links -%}
  <section class="rbx__section rbx__section--alt rbx-legal">
    <div class="rbx__wrap">
      {%- if s.legal_company != blank -%}<p class="rbx-legal__company">{{ s.legal_company }}</p>{%- endif -%}
      {%- if s.legal_address != blank -%}<p class="rbx-legal__line">{{ s.legal_address }}</p>{%- endif -%}
      <div class="rbx-legal__contact">
        {%- if s.legal_phone != blank -%}<a href="tel:{{ s.legal_phone | remove: ' ' }}">{{ ic_cash }} {{ s.legal_phone }}</a>{%- endif -%}
        {%- if s.legal_email != blank -%}<a href="mailto:{{ s.legal_email }}">{{ s.legal_email }}</a>{%- endif -%}
      </div>
      {%- if has_links -%}
      <div class="rbx-legal__links">
        {%- if s.returns_url != blank -%}<a href="{{ s.returns_url }}">{{ s.returns_label | default: 'Politique de retour' }}</a>{%- endif -%}
        {%- if s.contact_url != blank -%}<a href="{{ s.contact_url }}">{{ s.contact_label | default: 'Contact' }}</a>{%- endif -%}
        {%- if s.legal_url != blank -%}<a href="{{ s.legal_url }}">{{ s.legal_label | default: 'Mentions légales' }}</a>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ============ 11. STICKY CTA ============ {%- endcomment -%}
  <div class="rbx-sticky" data-rbx-sticky aria-hidden="true">
    <div class="rbx-sticky__price">
      <b>{{ price }}</b>
      <small>COD · Livraison gratuite</small>
    </div>
    {%- if wa_num != blank and wa_num != '212600000000' -%}
      <a href="{{ wa_link }}" class="rbx-sticky__wa" target="_blank" rel="nofollow noopener" aria-label="WhatsApp">{{ ic_wa }}</a>
    {%- endif -%}
    <a href="#rbx-order" class="rbx-btn" data-rbx-scroll>{{ s.sticky_btn | default: 'COMMANDER' }}</a>
  </div>

</div>

{%- comment -%} ============ SEO — Structured data (real values only) ============ {%- endcomment -%}
{%- liquid
  assign cur_code = s.currency_code | default: 'MAD'
  assign rc_digits = reviews_count | remove: ',' | remove: '+' | remove: ' '
  assign rev_blocks = section.blocks | where: 'type', 'review'
  assign faq_sd = section.blocks | where: 'type', 'faq'
-%}
{%- capture rbx_images -%}
{%- if p != blank and p.images.size > 0 -%}
{%- for image in p.images limit: 6 -%}{{ image | image_url: width: 1200 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
{%- elsif hero_img != blank -%}{{ hero_img | image_url: width: 1200 | json }}{%- endif -%}
{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ prod_title | json }},
  {%- if prod_desc != blank %}"description": {{ prod_desc | strip_html | truncatewords: 60 | json }},{% endif %}
  {%- assign rbx_images_t = rbx_images | strip %}{% if rbx_images_t != blank %}"image": [{{ rbx_images_t }}],{% endif %}
  "brand": { "@type": "Brand", "name": {{ s.legal_company | default: 'RBX' | json }} },
  "offers": {
    "@type": "Offer",
    "price": {{ unit_value | json }},
    "priceCurrency": {{ cur_code | json }},
    "availability": "https://schema.org/InStock"
  }{% if rating != blank %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating | json }},
    "reviewCount": {% if rc_digits != blank %}{{ rc_digits | json }}{% elsif rev_blocks.size > 0 %}"{{ rev_blocks.size }}"{% else %}"1"{% endif %}
  }{% endif %}{% if rev_blocks.size > 0 %},
  "review": [
    {%- for r in rev_blocks -%}
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": {{ r.settings.name | json }} },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": {{ r.settings.text | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]{% endif %}
}
</script>
{%- if faq_sd.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faq_sd -%}
    {
      "@type": "Question",
      "name": {{ f.settings.q | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.settings.a | strip_html | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- if s.pixel_id != blank -%}
<script>
  /* RBX — Meta Pixel bootstrap (only if not already loaded by theme/app). */
  (function () {
    if (window.fbq) return;
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', {{ s.pixel_id | json }});
    fbq('track', 'PageView');
