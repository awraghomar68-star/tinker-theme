{%- comment -%}
  RBX MOROCCO — Dynamic-product COD landing page section.
  Bind a Shopify product (schema "product" picker) and the hero/price/images/sizes
  pull live from it. With no product selected it falls back to schema defaults +
  snippets/rbx-placeholder.liquid so the page always builds.
{%- endcomment -%}

{{ 'rbx-landing-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign p = s.product

  # --- Price (prefer product, else setting, else hard default) ---
  assign price = blank
  assign compare = blank
  assign unit_value = blank
  if p != blank
    assign price = p.price | money
    if p.compare_at_price > p.price
      assign compare = p.compare_at_price | money
    endif
    assign unit_value = p.price | divided_by: 100
  endif
  assign price = price | default: s.price | default: '299 DH'
  assign compare = compare | default: s.compare_price | default: '399 DH'
  assign unit_value = unit_value | default: s.price_value | default: 299

  # --- Product copy fallbacks ---
  assign prod_title = p.title | default: s.hero_title | default: 'RBX Ensemble 2-en-1 Pro'
  assign prod_desc = p.description | default: blank

  # --- Images: prefer product, else setting, else placeholder ---
  assign hero_img = p.featured_image | default: s.hero_image
  assign img0 = p.images[0] | default: s.incl_image_1
  assign img1 = p.images[1] | default: s.incl_image_2
  assign img2 = p.images[2] | default: s.incl_image_3
  assign fab0 = p.images[3] | default: s.fabric_image_1
  assign fab1 = p.images[4] | default: s.fabric_image_2

  # --- Size option (variant-driven) ---
  assign size_opt = blank
  if p != blank
    for opt in p.options_with_values
      assign oname = opt.name | downcase
      if oname contains 'size' or oname contains 'taille'
        assign size_opt = opt
      endif
    endfor
  endif

  # --- Ratings / counts (no fabricated defaults — blank = hidden) ---
  assign rating = s.rating
  assign reviews_count = s.reviews_count
  assign orders_count = s.orders_count
  assign recommend_pct = s.recommend_pct

  # --- WhatsApp ---
  assign wa_raw = s.whatsapp | default: '212600000000'
  assign wa_num = wa_raw | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = s.whatsapp_msg | default: 'Salam, bghit ncommandi RBX Kit (COD)'
-%}
{%- capture wa_link -%}https://wa.me/{{ wa_num }}?text={{ wa_msg | url_encode }}{%- endcapture -%}

