</script>
{%- endif -%}
{{ 'rbx-landing-page.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "RBX Landing Page",
  "tag": "section",
  "class": "rbx-section",
  "settings": [
    { "type": "header", "content": "Produit (données dynamiques)" },
    { "type": "product", "id": "product", "label": "Produit lié", "info": "Sélectionnez le produit : titre, prix, prix barré, images et tailles seront tirés automatiquement. Laisser vide = valeurs par défaut + placeholders." },

    { "type": "header", "content": "Prix & devise (fallback / override)" },
    { "type": "text", "id": "price", "label": "Prix affiché", "info": "Utilisé seulement si aucun produit n'est lié.", "default": "299 DH" },
    { "type": "number", "id": "price_value", "label": "Prix (valeur numérique)", "info": "Pour le calcul JS quand aucun produit n'est lié.", "default": 299 },
    { "type": "text", "id": "currency", "label": "Devise (affichage)", "default": "DH" },
    { "type": "text", "id": "currency_code", "label": "Code devise ISO (SEO/Pixel)", "info": "Code ISO 4217 pour les données structurées. Ex: MAD.", "default": "MAD" },
    { "type": "text", "id": "compare_price", "label": "Ancien prix (barré)", "default": "399 DH" },
    { "type": "text", "id": "discount_badge", "label": "Badge réduction", "default": "-25%" },
    { "type": "text", "id": "bundle_prices", "label": "Prix packs (qty:total)", "info": "Ex: 1:299,2:499,3:699. Laisser vide = calcul auto à partir du prix produit − économies (recommandé).",  },
    { "type": "text", "id": "save2", "label": "Économie pack 2 (DH)", "default": "99" },
    { "type": "text", "id": "save3", "label": "Économie pack 3 (DH)", "default": "198" },

    { "type": "header", "content": "Barre d'annonce" },
    { "type": "text", "id": "announce_1", "label": "Annonce 1", "default": "Paiement à la livraison" },
