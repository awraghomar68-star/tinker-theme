        {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
        {%- if faq_blocks.size > 0 -%}
          {%- for f in faq_blocks -%}
            <div class="rbx-faq__item" {{ f.shopify_attributes }}>
              <button class="rbx-faq__q" aria-expanded="false">{{ f.settings.q }}<span class="rbx-faq__sign">+</span></button>
              <div class="rbx-faq__a"><div>{{ f.settings.a }}</div></div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign def_q = "Wach qualité mzyana?|Wach taille katji mzyan?|Wach tissu kay3req?|Wach kayb9a lawn?|Wach kayn échange?|Wach nkhales 9bel?" | split: '|' -%}
          {%- assign def_a = "Oui, tissu premium compression, finition haute qualité.|Oui, guide des tailles disponible (M, L, XL, XXL). Échange gratuit ila bghiti.|Non, tissu respirant kaymtass l3rg.|Oui, haute qualité, kayb9a lawn mn b3d ghasil.|Oui, échange taille gratuit w facile.|Non, paiement à la livraison (COD). Katkhalas mnin toselek commande." | split: '|' -%}
          {%- for q in def_q -%}
            <div class="rbx-faq__item">
              <button class="rbx-faq__q" aria-expanded="false">{{ q }}<span class="rbx-faq__sign">+</span></button>
              <div class="rbx-faq__a"><div>{{ def_a[forloop.index0] }}</div></div>
