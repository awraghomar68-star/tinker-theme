        <div class="rbx-trust__item">{{ ic_truck }}<b>{{ s.trust_2_title | default: 'Livraison gratuite' }}</b><span>{{ s.trust_2_text | default: 'Partout au Maroc' }}</span></div>
        <div class="rbx-trust__item">{{ ic_swap }}<b>{{ s.trust_3_title | default: 'Échange taille' }}</b><span>{{ s.trust_3_text | default: 'Gratuit w facile' }}</span></div>
        <div class="rbx-trust__item">{{ ic_shield }}<b>{{ s.trust_4_title | default: 'Garantie 30j' }}</b><span>{{ s.trust_4_text | default: 'Satisfait wla remboursé' }}</span></div>
