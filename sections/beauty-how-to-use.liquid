{%- comment -%}
  Beauty Care — How to use: numbered step blocks.
{%- endcomment -%}
{%- liquid assign s = section.settings -%}
<div class="beauty">
  <section class="beauty__section{% if s.alt_bg %} beauty__section--alt{% endif %}" style="padding-top:{{ s.padding_top | default: 48 }}px;padding-bottom:{{ s.padding_bottom | default: 48 }}px;">
    <div class="beauty__wrap">
      <p class="beauty__eyebrow">{{ s.eyebrow | default: 'Routine simple' }}</p>
      <h2 class="beauty__h2">{{ s.title | default: 'Comment utiliser votre pack' }}</h2>
      <div class="beauty-steps beauty-mt-24">
        {%- assign blocks = section.blocks | where: 'type', 'step' -%}
        {%- if blocks.size > 0 -%}
          {%- for b in blocks -%}
            <div class="beauty-step" {{ b.shopify_attributes }}>
              <div class="beauty-step__num">{{ forloop.index }}</div>
              <h3 class="beauty__h3">{{ b.settings.title }}</h3>
              <p class="beauty__p beauty-mb-0">{{ b.settings.text }}</p>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="beauty-step"><div class="beauty-step__num">1</div><h3 class="beauty__h3">Nettoyer</h3><p class="beauty__p beauty-mb-0">Appliquez le nettoyant matin et soir sur peau humide.</p></div>
          <div class="beauty-step"><div class="beauty-step__num">2</div><h3 class="beauty__h3">Exfolier</h3><p class="beauty__p beauty-mb-0">2 à 3 fois par semaine pour une peau lisse et nette.</p></div>
          <div class="beauty-step"><div class="beauty-step__num">3</div><h3 class="beauty__h3">Hydrater</h3><p class="beauty__p beauty-mb-0">Terminez avec la crème pour sceller l'hydratation.</p></div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Beauty How To Use",
  "tag": "section",
  "class": "beauty-section",
  "settings": [
    { "type": "checkbox", "id": "alt_bg", "label": "Fond alterné (blanc)", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Routine simple" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Comment utiliser votre pack" },
    { "type": "range", "id": "padding_top", "label": "Espace haut", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espace bas", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Nettoyer" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Appliquez le nettoyant matin et soir sur peau humide." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty How To Use",
      "blocks": [
        { "type": "step", "settings": { "title": "Nettoyer", "text": "Appliquez le nettoyant matin et soir sur peau humide." } },
        { "type": "step", "settings": { "title": "Exfolier", "text": "2 à 3 fois par semaine pour une peau lisse et nette." } },
        { "type": "step", "settings": { "title": "Hydrater", "text": "Terminez avec la crème pour sceller l'hydratation." } }
      ]
    }
  ]
}
{% endschema %}
