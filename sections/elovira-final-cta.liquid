{%- comment -%}
  ELOVIRA — Final CTA section (Phase 6). DS: FinalCTA.
  Independent, single-purpose closing banner. No blocks needed —
  one CTA per instance; merchants can duplicate for a second banner.
{%- endcomment -%}

{{ 'elovira-final-cta.css' | asset_url | stylesheet_tag }}

<div class="elovira elovira-final-cta" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="elovira-final-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="elovira-final-cta__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="elovira-final-cta__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="elovira-final-cta__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="elovira-final-cta__actions">
        {%- render 'elovira-button', label: section.settings.button_label, href: section.settings.button_link, default: '#', variant: 'gold', full: false -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ELOVIRA Final CTA",
  "tag": "section",
  "class": "elovira-final-cta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Votre routine vous attend" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Paiement à la livraison, livraison gratuite partout au Maroc.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choisir mon pack" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "ELOVIRA Final CTA" }
  ]
}
{% endschema %}
{% comment %}

