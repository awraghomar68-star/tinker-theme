{%- liquid
  assign s = section.settings
-%}

<section
  id="pack-landing-{{ section.id }}"
  class="pack-landing"
  dir="{{ s.direction }}"
  data-countdown-hours="{{ s.countdown_hours }}"
  data-stock-start="{{ s.stock_start }}"
  data-stock-min="{{ s.stock_min }}"
  data-enable-countdown="{{ s.enable_countdown }}"
  data-enable-sticky="{{ s.enable_sticky }}"
  data-enable-social="{{ s.enable_social }}"
  data-enable-exit="{{ s.enable_exit }}"
  data-social-names="{{ s.social_names | escape }}"
  data-social-cities="{{ s.social_cities | escape }}"
>
  {%- style -%}
    #pack-landing-{{ section.id }} {
      --c-primary: {{ s.color_primary }};
      --c-primary-dark: {{ s.color_primary | color_darken: 12 }};
      --c-secondary: {{ s.color_secondary }};
      --c-accent: {{ s.color_accent }};
      --maxw: {{ s.max_width }}px;
    }
  {%- endstyle -%}

  {%- if s.enable_countdown -%}
    <div class="cv-countdown" role="timer" aria-live="polite" hidden>
      <span class="cv-countdown__label">{{ s.countdown_label }}</span>
      <span class="cv-countdown__time" data-countdown-time>00:00:00</span>
    </div>
  {%- endif -%}

  <header class="pl-hero">
    <h1>{{ s.hero_title }}</h1>
    {%- if s.hero_subtitle != blank -%}<p>{{ s.hero_subtitle }}</p>{%- endif -%}
    {%- if s.hero_bullets != blank -%}<div class="pl-hero__bullets rte">{{ s.hero_bullets }}</div>{%- endif -%}
    {%- if s.hero_cta_label != blank -%}
      <p><a href="#pl-order-{{ section.id }}" class="pl-cta pl-cta--hero">{{ s.hero_cta_label }}</a></p>
    {%- endif -%}
  </header>

  <main class="pl-content">
    {%- assign current_grid = '' -%}
    {%- for block in section.blocks -%}
      {%- assign gtype = '' -%}
      {%- case block.type -%}
        {%- when 'trust_item', 'product', 'benefit', 'review', 'upsell' -%}
          {%- assign gtype = block.type -%}
      {%- endcase -%}

      {%- if gtype != current_grid -%}
        {%- if current_grid != '' -%}</div>{%- endif -%}
        {%- if gtype != '' -%}<div class="pl-grid pl-grid--{{ gtype }}">{%- endif -%}
        {%- assign current_grid = gtype -%}
      {%- endif -%}

      {%- case block.type -%}

        {%- when 'heading' -%}
          <div class="pl-band pl-band--heading" {{ block.shopify_attributes }}>
            {%- if block.settings.level == 'h3' -%}
              <h3>{{ block.settings.text }}</h3>
            {%- else -%}
              <h2>{{ block.settings.text }}</h2>
            {%- endif -%}
            {%- if block.settings.sub != blank -%}<p class="pl-band__sub">{{ block.settings.sub }}</p>{%- endif -%}
          </div>

        {%- when 'trust_item' -%}
          <div class="pl-trust" {{ block.shopify_attributes }}>
            <span class="pl-trust__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            <span class="pl-trust__text">{{ block.settings.text }}</span>
          </div>

        {%- when 'product' -%}
          <figure class="pl-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title, widths: '300, 450, 600' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'pl-card__placeholder' }}
            {%- endif -%}
            {%- if block.settings.title != blank -%}<figcaption>{{ block.settings.title }}</figcaption>{%- endif -%}
          </figure>

        {%- when 'benefit' -%}
          <div class="pl-benefit" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'why_paragraph' -%}
          <div class="pl-band pl-band--why rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'review' -%}
          <blockquote class="pl-review" {{ block.shopify_attributes }}>
            <p class="pl-review__quote">{{ block.settings.quote }}</p>
            {%- if block.settings.author != blank -%}
              <footer class="pl-review__author">— {{ block.settings.author }}</footer>
            {%- endif -%}
          </blockquote>

        {%- when 'offer' -%}
          <div id="pl-offer-{{ section.id }}" class="pl-band pl-offer" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
            <p class="pl-offer__price">
              <strong>{{ block.settings.price }}</strong>
              {%- if block.settings.old_price != blank -%}<del>{{ block.settings.old_price }}</del>{%- endif -%}
              {%- if block.settings.discount != blank -%}<span class="pl-offer__save">{{ block.settings.discount }}</span>{%- endif -%}
            </p>
            {%- if block.settings.subtext != blank -%}<p class="pl-offer__subtext">{{ block.settings.subtext }}</p>{%- endif -%}
            {%- if block.settings.show_table -%}
              <table class="pl-offer__table">
                {%- if block.settings.table_caption != blank -%}<caption>{{ block.settings.table_caption }}</caption>{%- endif -%}
                <thead>
                  <tr>
                    <th scope="col">{{ block.settings.col_qty }}</th>
                    <th scope="col">{{ block.settings.col_price }}</th>
                    <th scope="col">{{ block.settings.col_note }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>{{ block.settings.tier1_qty }}</td><td>{{ block.settings.tier1_price }}</td><td>{{ block.settings.tier1_note }}</td></tr>
                  <tr><td>{{ block.settings.tier2_qty }}</td><td>{{ block.settings.tier2_price }}</td><td>{{ block.settings.tier2_note }}</td></tr>
                  <tr><td>{{ block.settings.tier3_qty }}</td><td>{{ block.settings.tier3_price }}</td><td>{{ block.settings.tier3_note }}</td></tr>
                </tbody>
              </table>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <p><a href="#pl-order-{{ section.id }}" class="pl-cta">{{ block.settings.cta_label }}</a></p>
            {%- endif -%}
          </div>

        {%- when 'upsell' -%}
          <div class="pl-upsell" {{ block.shopify_attributes }}>
            <span class="pl-upsell__label">{{ block.settings.label }}</span>
            {%- if block.settings.price != blank -%}<span class="pl-upsell__price">{{ block.settings.price }}</span>{%- endif -%}
          </div>

        {%- when 'faq' -%}
          <details class="pl-faq" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="pl-faq__answer rte">{{ block.settings.answer }}</div>
          </details>

        {%- when 'order_form' -%}
          <div id="pl-order-{{ section.id }}" class="pl-band pl-order" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
            {%- form 'contact', class: 'pl-order__form' -%}
              {%- if form.posted_successfully? -%}
                <p class="pl-order__success">{{ block.settings.success_text }}</p>
              {%- else -%}
                {{ form.errors | default_errors }}
                <p>
                  <label for="pl-name-{{ section.id }}">{{ block.settings.label_name }}</label>
                  <input type="text" id="pl-name-{{ section.id }}" name="contact[name]" autocomplete="name" required>
                </p>
                <p>
                  <label for="pl-phone-{{ section.id }}">{{ block.settings.label_phone }}</label>
                  <input type="tel" id="pl-phone-{{ section.id }}" name="contact[phone]" autocomplete="tel" required>
                </p>
                <p>
                  <label for="pl-city-{{ section.id }}">{{ block.settings.label_city }}</label>
                  <input type="text" id="pl-city-{{ section.id }}" name="contact[city]" autocomplete="address-level2" required>
                </p>
                <p>
                  <label for="pl-address-{{ section.id }}">{{ block.settings.label_address }}</label>
                  <textarea id="pl-address-{{ section.id }}" name="contact[address]" autocomplete="street-address" required></textarea>
                </p>
                <p>
                  <label for="pl-pack-{{ section.id }}">{{ block.settings.label_pack }}</label>
                  <select id="pl-pack-{{ section.id }}" name="contact[pack]">
                    {%- if block.settings.pack1 != blank -%}<option value="{{ block.settings.pack1 }}">{{ block.settings.pack1 }}</option>{%- endif -%}
                    {%- if block.settings.pack2 != blank -%}<option value="{{ block.settings.pack2 }}">{{ block.settings.pack2 }}</option>{%- endif -%}
                    {%- if block.settings.pack3 != blank -%}<option value="{{ block.settings.pack3 }}">{{ block.settings.pack3 }}</option>{%- endif -%}
                  </select>
                </p>
                <p>
                  <button type="submit" class="pl-cta">{{ block.settings.submit_label }}</button>
                </p>
              {%- endif -%}
            {%- endform -%}
          </div>

      {%- endcase -%}

      {%- if forloop.last and current_grid != '' -%}</div>{%- endif -%}
    {%- endfor -%}
  </main>

  {%- if s.enable_sticky -%}
    <div class="cv-sticky" hidden>
      <div class="cv-sticky__info">
        {%- if s.sticky_price != blank -%}<span class="cv-sticky__price">{{ s.sticky_price }}</span>{%- endif -%}
        {%- if s.sticky_old != blank -%}<del class="cv-sticky__old">{{ s.sticky_old }}</del>{%- endif -%}
      </div>
      <a href="#pl-order-{{ section.id }}" class="cv-sticky__btn">{{ s.sticky_label }}</a>
    </div>
  {%- endif -%}

  {%- if s.enable_whatsapp and s.whatsapp_number != blank -%}
    <a class="cv-whatsapp" href="https://wa.me/{{ s.whatsapp_number }}?text={{ s.whatsapp_text | url_encode }}" target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" fill="#fff"><path d="M16 .4C7.4.4.5 7.3.5 15.9c0 2.8.7 5.4 2 7.7L.4 31.6l8.2-2.1c2.2 1.2 4.7 1.9 7.4 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.4 16 .4zm0 28.3c-2.4 0-4.6-.6-6.6-1.8l-.5-.3-4.9 1.3 1.3-4.8-.3-.5c-1.3-2-2-4.4-2-6.9C2.7 8.5 8.6 2.6 16 2.6S29.3 8.5 29.3 15.9 23.4 28.7 16 28.7zm8.2-9.6c-.4-.2-2.6-1.3-3-1.5-.4-.1-.7-.2-1 .2s-1.1 1.5-1.4 1.7c-.3.2-.5.3-.9.1-.4-.2-1.9-.7-3.6-2.2-1.3-1.2-2.2-2.6-2.5-3-.3-.4 0-.6.2-.8.2-.2.4-.5.6-.7.2-.2.3-.4.4-.7.1-.3.1-.5 0-.7-.1-.2-1-2.4-1.4-3.3-.4-.9-.7-.7-1-.7h-.8c-.3 0-.7.1-1.1.5s-1.5 1.4-1.5 3.5 1.5 4.1 1.7 4.4c.2.3 3 4.6 7.3 6.4 1 .4 1.8.7 2.4.9 1 .3 1.9.3 2.7.2.8-.1 2.6-1.1 3-2.1.4-1 .4-1.9.3-2.1-.1-.2-.4-.3-.8-.5z"/></svg>
    </a>
  {%- endif -%}

  {%- if s.enable_social -%}
    <div class="cv-social" role="status" aria-live="polite" hidden>
      <span class="cv-social__dot">🔥</span>
      <span class="cv-social__text"></span>
    </div>
  {%- endif -%}

  {%- if s.enable_exit -%}
    <div class="cv-exit" hidden>
      <div class="cv-exit__box" role="dialog" aria-modal="true" aria-labelledby="cv-exit-title-{{ section.id }}">
        <button type="button" class="cv-exit__close" aria-label="{{ s.exit_close_label }}">×</button>
        <h2 id="cv-exit-title-{{ section.id }}">{{ s.exit_title }}</h2>
        <div class="rte">{{ s.exit_body }}</div>
        {%- if s.exit_code != blank -%}<p class="cv-exit__code">{{ s.exit_code_label }} <strong>{{ s.exit_code }}</strong></p>{%- endif -%}
        <a href="#pl-order-{{ section.id }}" class="cv-exit__btn">{{ s.exit_cta_label }}</a>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.pack-landing {
  --c-primary: #D60000;
  --c-primary-dark: #A30000;
  --c-secondary: #111111;
  --c-accent: #FFD700;
  --c-bg: #FFFFFF;
  --c-muted: #f4f4f4;
  --c-border: #e4e4e4;
  --c-text: #111111;
  --c-text-soft: #555555;
  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px; --sp-7: 48px;
  --r-sm: 8px; --r-md: 14px; --r-lg: 22px; --r-pill: 999px;
  --f-base: 16px; --f-h1: 30px; --f-h2: 24px; --f-h3: 19px;
  --maxw: 720px;
  --shadow: 0 4px 18px rgba(0,0,0,.10);
  --shadow-cta: 0 6px 20px rgba(214,0,0,.35);
  box-sizing: border-box;
  background: var(--c-bg);
  color: var(--c-text);
  font-size: var(--f-base);
  line-height: 1.6;
  display: block;
}
.pack-landing *, .pack-landing *::before, .pack-landing *::after { box-sizing: border-box; }
.pack-landing img { max-width: 100%; height: auto; display: block; }
.pack-landing a { color: var(--c-primary); text-decoration: none; }
.pack-landing h1, .pack-landing h2, .pack-landing h3 {
  font-weight: 800; line-height: 1.25; color: var(--c-secondary);
  margin: 0 0 var(--sp-4); letter-spacing: -.2px;
}
.pack-landing h1 { font-size: var(--f-h1); }
.pack-landing h2 { font-size: var(--f-h2); }
.pack-landing h3 { font-size: var(--f-h3); }
.pack-landing p { margin: 0 0 var(--sp-3); }

.pl-content { max-width: var(--maxw); margin-inline: auto; padding: var(--sp-4); }
.pl-band { margin-block: var(--sp-6); }
.pl-band--heading h2, .pl-band--heading h3 {
  text-align: center; position: relative; padding-bottom: var(--sp-3);
}
.pl-band--heading h2::after {
  content: ""; display: block; width: 56px; height: 4px;
  background: var(--c-accent); border-radius: var(--r-pill); margin: var(--sp-3) auto 0;
}
.pl-band__sub { text-align: center; color: var(--c-text-soft); }

.pl-hero {
  background: linear-gradient(160deg, var(--c-secondary) 0%, #2a2a2a 100%);
  color: #fff; text-align: center; padding: var(--sp-7) var(--sp-4) var(--sp-6);
}
.pl-hero h1 { color: #fff; font-size: var(--f-h1); }
.pl-hero p { color: rgba(255,255,255,.9); font-size: 18px; margin-bottom: var(--sp-5); }
.pl-hero__bullets { display: inline-block; text-align: start; margin-bottom: var(--sp-5); font-weight: 600; }
.pl-hero__bullets ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-2); }

.pl-cta {
  display: block; width: 100%; max-width: 420px; margin: var(--sp-5) auto 0;
  padding: 18px var(--sp-5); background: var(--c-primary); color: #fff;
  font-size: 20px; font-weight: 800; text-align: center; border: none;
  border-radius: var(--r-pill); box-shadow: var(--shadow-cta); cursor: pointer;
  text-transform: uppercase; letter-spacing: .3px;
  transition: transform .12s ease, background .2s ease; animation: pl-cta-pulse 2.2s ease-in-out infinite;
}
.pl-cta:hover { background: var(--c-primary-dark); }
.pl-cta:active { transform: scale(.97); }
@keyframes pl-cta-pulse {
  0%, 100% { box-shadow: 0 6px 20px rgba(214,0,0,.35); }
  50% { box-shadow: 0 6px 28px rgba(214,0,0,.6); }
}
.pl-cta--hero { background: var(--c-accent); color: var(--c-secondary); box-shadow: 0 6px 22px rgba(255,215,0,.45); animation: none; }
.pl-cta--hero:hover { background: #ffe24d; }

.pl-grid { max-width: var(--maxw); margin-inline: auto; padding: var(--sp-3) var(--sp-4); display: grid; gap: var(--sp-3); }
.pl-grid--trust_item { grid-template-columns: repeat(2, 1fr); }
.pl-grid--product { grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
.pl-grid--benefit { grid-template-columns: repeat(2, 1fr); }
.pl-grid--review { grid-template-columns: 1fr; }
.pl-grid--upsell { grid-template-columns: 1fr; }

.pl-trust {
  background: var(--c-muted); border: 1px solid var(--c-border); border-radius: var(--r-md);
  padding: var(--sp-4) var(--sp-3); text-align: center; font-weight: 700; font-size: 14px;
  display: flex; flex-direction: column; align-items: center; gap: var(--sp-2);
}
.pl-trust__icon { font-size: 20px; }

.pl-card {
  margin: 0; background: #fff; border: 1px solid var(--c-border);
  border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow);
}
.pl-card img, .pl-card__placeholder { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
.pl-card figcaption { padding: var(--sp-3); text-align: center; font-weight: 700; }

.pl-benefit { background: var(--c-muted); border-radius: var(--r-sm); padding: var(--sp-3); font-weight: 600; font-size: 14px; }

.pl-band--why { background: var(--c-muted); border-radius: var(--r-md); padding: var(--sp-5); }

.pl-review {
  margin: 0; background: var(--c-muted); border-inline-start: 4px solid var(--c-accent);
  border-radius: var(--r-sm); padding: var(--sp-3) var(--sp-4); font-style: italic;
}
.pl-review__quote { margin: 0; }
.pl-review__quote::before { content: "“"; }
.pl-review__quote::after { content: "” ⭐⭐⭐⭐⭐"; }
.pl-review__author { font-style: normal; font-weight: 700; margin-top: var(--sp-2); }

.pl-offer { text-align: center; }
.pl-offer__price { font-size: 22px; }
.pl-offer__price strong { color: var(--c-primary); font-size: 34px; font-weight: 900; }
.pl-offer__price del { color: var(--c-text-soft); font-size: 20px; margin-inline: var(--sp-2); }
.pl-offer__table {
  width: 100%; border-collapse: collapse; margin: var(--sp-5) 0; font-size: 15px;
  box-shadow: var(--shadow); border-radius: var(--r-md); overflow: hidden;
}
.pl-offer__table caption { font-weight: 800; margin-bottom: var(--sp-3); color: var(--c-secondary); }
.pl-offer__table th, .pl-offer__table td { padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--c-border); text-align: start; }
.pl-offer__table thead th { background: var(--c-secondary); color: #fff; }
.pl-offer__table tbody tr:nth-child(2) { background: #fff8d6; font-weight: 700; }

.pl-upsell { border: 2px dashed var(--c-primary); border-radius: var(--r-md); padding: var(--sp-4); text-align: center; font-weight: 700; display: flex; justify-content: center; gap: var(--sp-2); }

.pl-faq { border: 1px solid var(--c-border); border-radius: var(--r-md); margin-bottom: var(--sp-3); overflow: hidden; background: #fff; }
.pl-faq summary { cursor: pointer; list-style: none; padding: var(--sp-4); font-weight: 700; background: var(--c-muted); position: relative; }
.pl-faq summary::-webkit-details-marker { display: none; }
.pl-faq summary::after { content: "＋"; position: absolute; inset-inline-end: var(--sp-4); color: var(--c-primary); font-weight: 900; }
.pl-faq[open] summary::after { content: "－"; }
.pl-faq__answer { padding: 0 var(--sp-4) var(--sp-4); }

.pl-order__form { background: var(--c-muted); padding: var(--sp-5); border-radius: var(--r-lg); box-shadow: var(--shadow); max-width: 480px; margin-inline: auto; }
.pl-order__form label { font-weight: 700; display: block; margin-bottom: var(--sp-2); }
.pl-order input, .pl-order textarea, .pl-order select {
  width: 100%; padding: 14px var(--sp-4); font-size: 16px; border: 1px solid var(--c-border);
  border-radius: var(--r-sm); background: #fff; font-family: inherit;
}
.pl-order input:focus, .pl-order textarea:focus, .pl-order select:focus { outline: none; border-color: var(--c-primary); box-shadow: 0 0 0 3px rgba(214,0,0,.15); }
.pl-order textarea { min-height: 80px; resize: vertical; }
.pl-order__success { background: #1a8f3c; color: #fff; padding: var(--sp-4); border-radius: var(--r-md); text-align: center; font-weight: 700; }

.cv-countdown { position: sticky; top: 0; z-index: 60; background: #c0392b; color: #fff; text-align: center; padding: 8px 12px; font-weight: 700; font-size: 15px; display: flex; gap: 8px; justify-content: center; align-items: center; }
.cv-countdown__time { font-variant-numeric: tabular-nums; background: #000; padding: 2px 8px; border-radius: 6px; }

.cv-sticky { position: fixed; bottom: 0; left: 0; right: 0; z-index: 55; background: #fff; box-shadow: 0 -4px 16px rgba(0,0,0,.15); display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; transform: translateY(110%); transition: transform .3s ease; }
.cv-sticky.cv-show { transform: translateY(0); }
.cv-sticky__info { display: flex; flex-direction: column; line-height: 1.2; }
.cv-sticky__price { font-size: 20px; font-weight: 800; color: #27ae60; }
.cv-sticky__old { color: #999; font-size: 14px; }
.cv-sticky__btn { background: #e67e22; color: #fff; font-weight: 800; padding: 12px 22px; border-radius: 10px; text-decoration: none; font-size: 16px; white-space: nowrap; }

.cv-whatsapp { position: fixed; bottom: 84px; right: 18px; z-index: 50; width: 56px; height: 56px; border-radius: 50%; background: #25d366; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,.3); animation: cv-pulse 2s infinite; }
@keyframes cv-pulse { 0% { box-shadow: 0 0 0 0 rgba(37,211,102,.5); } 70% { box-shadow: 0 0 0 14px rgba(37,211,102,0); } 100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); } }

.cv-social { position: fixed; bottom: 150px; left: 18px; z-index: 48; background: #fff; border-radius: 12px; box-shadow: 0 6px 20px rgba(0,0,0,.18); padding: 12px 16px; display: flex; align-items: center; gap: 10px; max-width: 300px; font-size: 14px; transform: translateX(-120%); transition: transform .4s ease; }
.cv-social.cv-show { transform: translateX(0); }
.cv-social__dot { font-size: 20px; }
.cv-social__text strong { color: #c0392b; }

.cv-exit { position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.7); display: flex; align-items: center; justify-content: center; padding: 20px; }
.cv-exit__box { background: #fff; border-radius: 16px; max-width: 420px; width: 100%; padding: 30px 24px; text-align: center; position: relative; animation: cv-pop .3s ease; }
@keyframes cv-pop { from { transform: scale(.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.cv-exit__close { position: absolute; top: 10px; left: 14px; background: none; border: none; font-size: 28px; line-height: 1; cursor: pointer; color: #999; }
.cv-exit__box h2 { margin: 0 0 12px; font-size: 22px; color: #c0392b; }
.cv-exit__code { background: #f7f7f7; border: 2px dashed #e67e22; border-radius: 8px; padding: 8px; margin: 14px 0; }
.cv-exit__btn { display: inline-block; background: #27ae60; color: #fff; font-weight: 800; padding: 14px 28px; border-radius: 10px; text-decoration: none; font-size: 17px; margin-top: 6px; }

.cv-stock { margin: 14px 0; padding: 12px 14px; background: #fff4e5; border: 1px solid #ffd9a8; border-radius: 10px; font-weight: 700; color: #c0392b; }
.cv-stock__bar { height: 8px; background: #eee; border-radius: 6px; overflow: hidden; margin-top: 8px; }
.cv-stock__fill { height: 100%; background: linear-gradient(90deg,#e74c3c,#e67e22); transition: width .4s; }

@media (min-width: 768px) {
  .pack-landing { --f-h1: 40px; --f-h2: 30px; --f-h3: 22px; }
  .pl-grid--product { grid-template-columns: repeat(3, 1fr); }
  .pl-grid--trust_item { grid-template-columns: repeat(4, 1fr); }
  .pl-grid--review, .pl-grid--upsell { grid-template-columns: repeat(2, 1fr); }
  .pl-hero__bullets ul { flex-direction: row; gap: var(--sp-5); }
}
@media (min-width: 1024px) {
  .pack-landing { --maxw: 860px; }
  .pl-hero { padding-block: 72px; }
}
@media (max-width: 360px) {
  .pl-grid--benefit, .pl-grid--trust_item { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .pl-cta { animation: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  "use strict";
  var roots = document.querySelectorAll(".pack-landing");
  roots.forEach(function (root) {
    if (root.dataset.plInit) return;
    root.dataset.plInit = "1";

    var hours = parseInt(root.dataset.countdownHours, 10) || 24;
    var stockStart = parseInt(root.dataset.stockStart, 10) || 37;
    var stockMin = parseInt(root.dataset.stockMin, 10) || 4;

    var cd = root.querySelector(".cv-countdown");
    var cdTime = root.querySelector("[data-countdown-time]");
    if (cd && cdTime) {
      var KEY = "cv_deadline";
      var deadline = +localStorage.getItem(KEY);
      if (!deadline || deadline < Date.now()) {
        deadline = Date.now() + hours * 3600 * 1000;
        localStorage.setItem(KEY, deadline);
      }
      var pad = function (n) { return n < 10 ? "0" + n : "" + n; };
      var tick = function () {
        var diff = deadline - Date.now();
        if (diff <= 0) {
          deadline = Date.now() + hours * 3600 * 1000;
          localStorage.setItem(KEY, deadline);
          diff = deadline - Date.now();
        }
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        cdTime.textContent = pad(h) + ":" + pad(m) + ":" + pad(s);
      };
      cd.hidden = false;
      tick();
      setInterval(tick, 1000);
    }

    var sticky = root.querySelector(".cv-sticky");
    var orderEl = root.querySelector('[id^="pl-order-"]');
    if (sticky && orderEl) {
      sticky.hidden = false;
      var toggleSticky = function () {
        var pastHero = window.scrollY > 400;
        var rect = orderEl.getBoundingClientRect();
        var formVisible = rect.top < window.innerHeight && rect.bottom > 0;
        sticky.classList.toggle("cv-show", pastHero && !formVisible);
      };
      window.addEventListener("scroll", toggleSticky, { passive: true });
      toggleSticky();
    }

    var wa = root.querySelector(".cv-whatsapp");
    if (wa) wa.hidden = false;

    var offer = root.querySelector('[id^="pl-offer-"]');
    if (offer) {
      var sKey = "cv_stock";
      var saved = +localStorage.getItem(sKey);
      var stock = (saved && saved >= stockMin) ? saved : stockStart;
      if (Math.random() < 0.6 && stock > stockMin) stock--;
      localStorage.setItem(sKey, stock);
      var box = document.createElement("div");
      box.className = "cv-stock";
      var pct = Math.max(8, Math.round((stock / stockStart) * 100));
      box.innerHTML = "🔥 <strong>" + stock + "</strong> / " + stockStart +
        '<div class="cv-stock__bar"><div class="cv-stock__fill" style="width:' + pct + '%"></div></div>';
      offer.insertBefore(box, offer.firstChild);
    }

    var social = root.querySelector(".cv-social");
    if (social) {
      var socialText = social.querySelector(".cv-social__text");
      var names = (root.dataset.socialNames || "").split(",").map(function (x) { return x.trim(); }).filter(Boolean);
      var cities = (root.dataset.socialCities || "").split(",").map(function (x) { return x.trim(); }).filter(Boolean);
      var rand = function (a) { return a[Math.floor(Math.random() * a.length)]; };
      if (names.length && cities.length) {
        var showSocial = function () {
          var mins = Math.floor(Math.random() * 28) + 2;
          socialText.innerHTML = "<strong>" + rand(names) + "</strong> · " + rand(cities) + " · " + mins + " min";
          social.hidden = false;
          social.classList.add("cv-show");
          setTimeout(function () { social.classList.remove("cv-show"); }, 5000);
          setTimeout(showSocial, 9000 + Math.random() * 6000);
        };
        setTimeout(showSocial, 4000);
      }
    }

    var exit = root.querySelector(".cv-exit");
    if (exit) {
      var shown = sessionStorage.getItem("cv_exit_shown");
      var openExit = function () {
        if (shown) return;
        shown = 1;
        sessionStorage.setItem("cv_exit_shown", "1");
        exit.hidden = false;
      };
      var closeExit = function () { exit.hidden = true; };
      document.addEventListener("mouseout", function (e) {
        if (!e.relatedTarget && e.clientY <= 0) openExit();
      });
      var lastY = 0, engaged = false;
      setTimeout(function () { engaged = true; }, 8000);
      window.addEventListener("scroll", function () {
        if (engaged && window.scrollY < lastY - 40 && window.scrollY < 200) openExit();
        lastY = window.scrollY;
      }, { passive: true });
      var closeBtn = exit.querySelector(".cv-exit__close");
      if (closeBtn) closeBtn.addEventListener("click", closeExit);
      var exitCta = exit.querySelector(".cv-exit__btn");
      if (exitCta) exitCta.addEventListener("click", closeExit);
      exit.addEventListener("click", function (e) { if (e.target === exit) closeExit(); });
    }
  });
})();
{% endjavascript %}

