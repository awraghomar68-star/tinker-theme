{%- comment -%}
  ELOVIRA — generic static page wrapper (Phase 13).
  Presentation-only shell around Horizon's native page/theme-block
  architecture. Accepts native @theme blocks (text, image,
  page-content, contact-form, accordion, etc.) via content_for
  'blocks' — identical composition model to sections/main-page.liquid.
  No business logic duplicated: contact form handling, accordion
  interaction (<details>), and RTE rendering all stay native.
{%- endcomment -%}

{{ 'elovira-page.css' | asset_url | stylesheet_tag }}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section elovira elovira-page page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="elovira-page"
>
  <div class="elovira-page__wrapper spacing-style layout-panel-flex layout-panel-flex--column section-content-wrapper mobile-column">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "ELOVIRA Page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": []
}
{% endschema %}
