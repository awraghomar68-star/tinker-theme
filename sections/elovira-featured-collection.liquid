{%- comment -%}
  ELOVIRA — Featured collection section (Phase 6). DS: ProductGrid.
  Independent: merchant picks a real collection (native picker),
  no invented product data. Handles empty collection gracefully.
  Reuses elovira-product-card atom for every tile.
{%- endcomment -%}

{{ 'elovira-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.product_limit | default: 8
-%}

<div
  class="elovira elovira-featured-collection{% if section.settings.alt_bg %} elovira-section--alt{% endif %}"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="elovira-featured-collection__inner">
    <div class="elovira-featured-collection__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="elovira-featured-collection__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="elovira-featured-collection__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        {%- render 'elovira-button', label: section.settings.view_all_label, href: collection.url, variant: 'ghost', size: 'sm', full: false -%}
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="elovira-featured-collection__grid">
        {%- for product in collection.products limit: limit -%}
          {%- liquid
            assign loading = 'lazy'
            if forloop.index <= 2
              assign loading = 'eager'
            endif
          -%}
          {%- render 'elovira-product-card', product: product, image_loading: loading -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="elovira-product-card__empty">{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ELOVIRA Collection",
  "tag": "section",
  "class": "elovira-featured-collection-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nos coffrets" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"view all\" button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "Voir tout" },
    { "type": "text", "id": "empty_text", "label": "Empty collection text", "default": "Aucun produit à afficher pour le moment." },
    { "type": "checkbox", "id": "alt_bg", "label": "Alternate background", "default": false },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "ELOVIRA Collection", "settings": { "heading": "Nos coffrets" } }
  ]
}
{% endschema %}
