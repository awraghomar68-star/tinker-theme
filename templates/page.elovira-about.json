{
  "sections": {
    "main": {
      "type": "elovira-page",
      "blocks": {
        "heading": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ closest.page.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "font": "var(--font-heading--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "hero_image": {
          "type": "image",
          "name": "t:names.image",
          "settings": {
            "width": "100%",
            "max_width": "normal"
          },
          "blocks": {}
        },
        "page_content": {
          "type": "page-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": ["heading", "hero_image", "page_content"],
      "settings": {
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 48,
        "padding-block-end": 80
      }
    }
  },
  "order": ["main"]
}
