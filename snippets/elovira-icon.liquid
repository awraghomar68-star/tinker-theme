{%- comment -%}
  ELOVIRA — Icon atom (Phase 3, hybrid glyph strategy)
  Single, centralized icon abstraction. Renders a glyph as either
  Unicode (DS default) or inline SVG (Android-hardened fallback),
  chosen centrally here — never scattered across components.

  Faithful to the frozen DS: default is the DS Unicode glyph; the
  SVG path is a visually-identical stand-in used only for the small
  set of FUNCTIONAL glyphs known to vary across system fonts.

  Params:
    name   (required) — glyph key (see map below)
    size   (px, default 16) — sets glyph font-size / svg box (1em)
    mode   'auto' (default) | 'unicode' | 'svg' — override rendering
    circle (bool) — wrap in the 52px rose->beige gradient medallion
    label  (string) — accessible name; when set -> role="img";
                       when absent -> aria-hidden (decorative)
    class  (string) — extra classes on the icon root

  Reusable across Home / PLP / PDP / Cart / Search. No hardcoded copy.
  Owns its styles via elovira-icon.css.
{%- endcomment -%}

{{ 'elovira-icon.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign icon_name = name | default: ''
  assign icon_size = size | default: 16
  assign icon_mode = mode | default: 'auto'

  assign glyph = ''
  assign svg = ''
  assign prefer = 'unicode'

  case icon_name
    # ---- Functional glyphs (prefer SVG: vary across Android/system fonts) ----
    when 'search'
      assign glyph = '⌕'
      assign prefer = 'svg'
      assign svg = '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>'
    when 'close'
      assign glyph = '✕'
      assign prefer = 'svg'
      assign svg = '<path d="M6 6l12 12M18 6L6 18"/>'
    when 'menu'
      assign glyph = '≡'
      assign prefer = 'svg'
      assign svg = '<path d="M3 6h18M3 12h18M3 18h18"/>'
    when 'cart'
      assign glyph = '⛰'
      assign prefer = 'svg'
      assign svg = '<circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2 3h2.4l2.3 12.4a1.6 1.6 0 0 0 1.6 1.3h8.7a1.6 1.6 0 0 0 1.6-1.3L22 7H5.2"/>'
    when 'heart'
      assign glyph = '♡'
      assign prefer = 'svg'
      assign svg = '<path d="M12 20.5l-1.4-1.3C5.9 15 3 12.4 3 9.1A4.1 4.1 0 0 1 12 6.3 4.1 4.1 0 0 1 21 9.1c0 3.3-2.9 5.9-7.6 10.1z"/>'
    when 'heart-filled'
      assign glyph = '♥'
      assign prefer = 'svg'
      assign svg = '<path d="M12 20.5l-1.4-1.3C5.9 15 3 12.4 3 9.1A4.1 4.1 0 0 1 12 6.3 4.1 4.1 0 0 1 21 9.1c0 3.3-2.9 5.9-7.6 10.1z" fill="currentColor" stroke="none"/>'
    when 'filter'
      assign glyph = '⇅'
      assign prefer = 'svg'
      assign svg = '<path d="M3 5h18M6 12h12M10 19h4"/>'
    when 'chevron-down'
      assign glyph = '⌄'
      assign prefer = 'svg'
      assign svg = '<path d="M6 9l6 6 6-6"/>'
    when 'chevron-up'
      assign glyph = '⌃'
      assign prefer = 'svg'
      assign svg = '<path d="M6 15l6-6 6 6"/>'
    when 'chevron-left'
      assign glyph = '‹'
      assign prefer = 'svg'
      assign svg = '<path d="M15 6l-6 6 6 6"/>'
    when 'chevron-right'
      assign glyph = '›'
      assign prefer = 'svg'
      assign svg = '<path d="M9 6l6 6-6 6"/>'
    when 'arrow-right'
      assign glyph = '→'
      assign prefer = 'svg'
      assign svg = '<path d="M5 12h14M13 6l6 6-6 6"/>'
    when 'truck'
      assign glyph = '⛟'
      assign prefer = 'svg'
      assign svg = '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>'
    when 'shield'
      assign glyph = '⛨'
      assign prefer = 'svg'
      assign svg = '<path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/>'
    when 'lock'
      assign glyph = '⚿'
      assign prefer = 'svg'
      assign svg = '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>'
    when 'clock'
      assign glyph = '◷'
      assign prefer = 'svg'
      assign svg = '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>'
    when 'user'
      assign glyph = '☺'
      assign prefer = 'svg'
      assign svg = '<circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6"/>'
    when 'share'
      assign glyph = '⇗'
      assign prefer = 'svg'
      assign svg = '<circle cx="18" cy="5" r="2.4"/><circle cx="6" cy="12" r="2.4"/><circle cx="18" cy="19" r="2.4"/><path d="M8.1 10.8l7.8-4.5M8.1 13.2l7.8 4.5"/>'
    when 'whatsapp'
      assign glyph = '⌾'
      assign prefer = 'svg'
      assign svg = '<path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/><path d="M9 9c.3 2 2 3.7 4 4l1-1.4 2 .8-.4 2c-2.8.6-6.2-2.8-6.8-6l2-.8z" fill="currentColor" stroke="none"/>'
    when 'instagram'
      assign glyph = '◎'
      assign prefer = 'svg'
      assign svg = '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>'
    when 'tiktok'
      assign glyph = '♪'
      assign prefer = 'svg'
      assign svg = '<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5c.3 0 .6 0 .9.1V8a6 6 0 1 0 4.6 5.8V9.3a6.4 6.4 0 0 0 3.5 1.1V7.4a3.9 3.9 0 0 1-2.5-1A4 4 0 0 1 15.9 4z" fill="currentColor" stroke="none"/>'
    when 'facebook'
      assign glyph = 'f'
      assign prefer = 'svg'
      assign svg = '<path d="M14 9h2.5V5.5H14C11.8 5.5 10.5 7 10.5 9v2.5H8V15h2.5v5.5H14V15h2.2l.6-3.5H14V9.3c0-.2.1-.3.3-.3z" fill="currentColor" stroke="none"/>'

    # ---- Decorative / consistent glyphs (prefer Unicode; SVG optional) ----
    when 'check'
      assign glyph = '✓'
      assign prefer = 'unicode'
      assign svg = '<path d="M5 12l4.5 4.5L19 6"/>'
    when 'star'
      assign glyph = '★'
      assign prefer = 'unicode'
      assign svg = '<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.1 5.9-.8z" fill="currentColor" stroke="none"/>'
    when 'plus'
      assign glyph = '+'
      assign prefer = 'unicode'
      assign svg = '<path d="M12 5v14M5 12h14"/>'
    when 'minus'
      assign glyph = '−'
      assign prefer = 'unicode'
      assign svg = '<path d="M5 12h14"/>'
    when 'sparkle'
      assign glyph = '✦'
      assign prefer = 'unicode'
    when 'flower'
      assign glyph = '✿'
      assign prefer = 'unicode'
    else
      assign glyph = icon_name
      assign prefer = 'unicode'
  endcase

  assign use = prefer
  if icon_mode == 'unicode'
    assign use = 'unicode'
  elsif icon_mode == 'svg'
    assign use = 'svg'
  endif
  if use == 'svg' and svg == blank
    assign use = 'unicode'
  endif

  assign root_class = 'elovira-icon'
  if class != blank
    assign root_class = root_class | append: ' ' | append: class
  endif
-%}

{%- capture icon_inner -%}
  {%- if use == 'svg' -%}
    <span class="{{ root_class }}" style="font-size:{{ icon_size }}px"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true"{% endif %}><svg viewBox="0 0 24 24" width="1em" height="1em" focusable="false">{{ svg }}</svg></span>
  {%- else -%}
    <span class="{{ root_class }}" style="font-size:{{ icon_size }}px"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true"{% endif %}>{{ glyph }}</span>
  {%- endif -%}
{%- endcapture -%}

{%- if circle -%}
  <span class="elovira-icon-medallion"{% if label == blank %} aria-hidden="true"{% endif %}>{{ icon_inner }}</span>
{%- else -%}
  {{ icon_inner }}
{%- endif -%}
